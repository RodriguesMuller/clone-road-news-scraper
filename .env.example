# Copie este arquivo para .env para rodar o scraper localmente
# Nunca commite o arquivo .env — ele já está no .gitignore

# Connection string do PostgreSQL (Supabase).
# No painel do Supabase: Project Settings → Database → Connection string.
# Use a opção "Session pooler" (compatível com IPv4, exigido pelo GitHub
# Actions) e substitua [YOUR-PASSWORD] pela senha do banco.
# Formato: postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.xxxxxxxx:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# IA para resumo semanal (GitHub Actions e Vercel API)
OPENAI_API_KEY=sk-proj_xxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-4.1-mini

# Auth/controle de acesso na Vercel
# AUTH_ENABLED=true exige login no front e valida cotas nas APIs.
# Se ficar vazio em producao, o app falha fechado e exige login.
# Use false explicitamente apenas para preview/demo. O modo demo nao libera Admin.
AUTH_ENABLED=false
# Opcional: mantido por compatibilidade com deploys antigos.
NEXT_PUBLIC_AUTH_ENABLED=false
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# Somente no servidor/Vercel Functions. Nunca usar no front-end.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxx

# Weekly news por e-mail via Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
WEEKLY_EMAIL_FROM=Road News <onboarding@resend.dev>
WEEKLY_EMAIL_TO=email1@empresa.com,email2@empresa.com
