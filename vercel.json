{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/login", "destination": "/" },
    { "source": "/accept-invite", "destination": "/" },
    { "source": "/auth/callback", "destination": "/" },
    { "source": "/dashboard", "destination": "/" },
    { "source": "/alertas", "destination": "/" },
    { "source": "/central-eventos", "destination": "/" },
    { "source": "/noticias", "destination": "/" },
    { "source": "/salvos", "destination": "/" },
    { "source": "/resumo-operacional", "destination": "/" },
    { "source": "/tendencias", "destination": "/" },
    { "source": "/fontes", "destination": "/" },
    { "source": "/relatorios", "destination": "/" },
    { "source": "/configuracoes", "destination": "/" },
    { "source": "/mapa", "destination": "/" },
    { "source": "/minha-rota", "destination": "/" },
    { "source": "/resumo-semanal", "destination": "/" },
    { "source": "/admin", "destination": "/" },
    { "source": "/gestor", "destination": "/" },
    { "source": "/clientes", "destination": "/" },
    { "source": "/usuarios", "destination": "/" },
    { "source": "/pacotes", "destination": "/" },
    { "source": "/consumo", "destination": "/" },
    { "source": "/fontes-gestor", "destination": "/" },
    { "source": "/relatorios-gestor", "destination": "/" },
    { "source": "/developer", "destination": "/" },
    { "source": "/developer/clientes", "destination": "/" },
    { "source": "/developer/fontes", "destination": "/" },
    { "source": "/developer/relatorios", "destination": "/" },
    { "source": "/monitoramento", "destination": "/" },
    { "source": "/integracoes", "destination": "/" },
    { "source": "/banco", "destination": "/" },
    { "source": "/logs", "destination": "/" },
    { "source": "/developer/usuarios", "destination": "/" },
    { "source": "/developer/pacotes", "destination": "/" },
    { "source": "/developer/consumo", "destination": "/" },
    { "source": "/developer/configuracoes", "destination": "/" }
  ]
}
