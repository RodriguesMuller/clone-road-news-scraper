      "css": ".ds-btn-secondary{background:#fff;color:#10233F;border:1px solid #CAD2DC;border-radius:6px;padding:9px 16px;font:700 14px Archivo,'Segoe UI',system-ui,sans-serif;cursor:pointer;transition:border-color .15s ease}.ds-btn-secondary:hover{border-color:#536177}.ds-btn-secondary:focus-visible{outline:2px solid #1D4F91;outline-offset:2px}"
