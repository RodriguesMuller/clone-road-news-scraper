      "html": "<div class=\"ds-grades\"><span class=\"ds-grade\" style=\"background:#C8201A;color:#fff\">Crítico</span><span class=\"ds-grade\" style=\"background:#E46C00;color:#10233F\">Alto</span><span class=\"ds-grade\" style=\"background:#EDB800;color:#10233F\">Médio</span><span class=\"ds-grade\" style=\"background:#5F6E83;color:#fff\">Baixo</span></div>",
      "css": ".ds-grades{display:flex;gap:6px}.ds-grade{font:800 12px Archivo,'Segoe UI',system-ui,sans-serif;padding:4px 8px;border-radius:4px}"
    }
