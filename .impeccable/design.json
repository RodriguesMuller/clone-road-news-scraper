      "html": "<nav class=\"ds-nav\"><div class=\"ds-nav-brand\"><i></i><strong>Road News</strong></div><a class=\"ds-nav-item active\" href=\"#\">Situação agora</a><a class=\"ds-nav-item\" href=\"#\">Avisos</a><a class=\"ds-nav-item\" href=\"#\">Minha Rota</a></nav>",
      "css": ".ds-nav{background:#10233F;color:#E3E9F1;padding:16px 12px;display:grid;gap:4px;width:220px;font:400 14px Archivo,'Segoe UI',system-ui,sans-serif}.ds-nav-brand{display:flex;align-items:center;gap:10px;margin-bottom:12px}.ds-nav-brand i{width:6px;height:28px;border-radius:2px;background-image:linear-gradient(#C8201A 0 25%,#E46C00 25% 50%,#EDB800 50% 75%,#5F6E83 75%)}.ds-nav-brand strong{color:#fff;font-weight:800;letter-spacing:-.01em}.ds-nav-item{color:#E3E9F1;text-decoration:none;padding:8px 10px;border-radius:6px}.ds-nav-item:hover{background:#1B355C;color:#fff}.ds-nav-item.active{background:#fff;color:#10233F;font-weight:700}.ds-nav-item:focus-visible{outline:2px solid #fff;outline-offset:2px}"
